# Production environment variables -- set these in Railway's dashboard,
# NEVER in a committed file. This file documents what's needed, with
# no real values.

APP_NAME="Enterprise AI Assistant API"
ENVIRONMENT=production

# Provided automatically by Railway's managed Postgres -- see Task 15.3
DATABASE_URL=

# Generate fresh, do not reuse local dev values
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Consider a separate production key from Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash,gemini-2.5-flash,gemini-2.5-flash-lite

# Point at your deployed Neo4j/Qdrant services (Task 15.3)
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

QDRANT_URL=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# MUST be false for real users to get real answers
MOCK_MODE=false
