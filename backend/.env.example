# Copy this file to .env and fill in real values. Never commit .env itself.

APP_NAME="Enterprise AI Assistant API"
ENVIRONMENT=development

DATABASE_URL=postgresql://enterprise_ai_user:enterprise_ai_password@localhost:5432/enterprise_ai

# Google Gemini -- used for two DIFFERENT purposes:
# GEMINI_MODEL: chat/generation (used starting Step 9's AI agents)
# EMBEDDING_MODEL: converting text to vectors (used starting Step 6/7)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=enterprise_ai_password

QDRANT_URL=https://d036f130-50ae-4264-919e-6df1c21483d5.us-east-1-1.aws.cloud.qdrant.io
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash,gemini-2.5-flash,gemini-2.5-flash-lite
MOCK_MODE=false
JWT_SECRET_KEY=your-random-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
QDRANT_API_KEY=your-qdrant-cloud-api-key-if-using-cloud
